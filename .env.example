# Chave pública opcional para os basemaps CARTO.
# Variáveis VITE_* entram no bundle do navegador; nunca coloque segredos aqui.
# Restrinja esta chave aos domínios autorizados antes de usá-la em produção.
# Sem esta variável, o app usa OpenStreetMap e mantém a atribuição visível.
VITE_CARTO_API_KEY=
